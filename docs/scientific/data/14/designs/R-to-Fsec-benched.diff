+            tables  (hash-tables)
+            bits    (js/Float64Array. 1)
+            words   (js/Uint32Array. (.-buffer bits))
+            ;; match k's index hashes, each computed as a pass computes its index: ℓ under h0 and h1, x …, y …
+            axes    (js/Int32Array. (* 6 m))

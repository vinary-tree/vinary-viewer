+(defn- by-height
+  "The note page's upright runs, grouped by string: a js/Map from each string to #js [heights xs ys], three
+   Float64Arrays holding its runs' run-height and origin in ascending order of height."
+  [note]
+  (let [groups (js/Map.)]
+    (doseq [r note]
+      (when (upright? r)
+        (if-let [rs (.get groups (:str r))] (.push rs r) (.set groups (:str r) #js [r]))))
+    (let [out (js/Map.)]
+      (.forEach groups
+                (fn [^js rs s]
+                  (let [n      (.-length rs)
+                        h      (js/Float64Array. n)
+                        _      (dotimes [k n] (aset h k (run-height (aget rs k))))
+                        order  (let [o (js/Array. n)] (dotimes [k n] (aset o k k)) o)
+                        ;; heights are never NaN (upright?), but may be +∞, so compare, never subtract
+                        _      (.sort order (fn [a b] (let [x (aget h a) y (aget h b)] (cond (< x y) -1 (> x y) 1 :else 0))))
+                        hs     (js/Float64Array. n)
+                        xs     (js/Float64Array. n)
+                        ys     (js/Float64Array. n)]
+                    (dotimes [k n]
+                      (let [j (aget order k)
+                            [_ _ _ _ x y] (:t (aget rs j))]
+                        (aset hs k (aget h j))
+                        (aset xs k x)
+                        (aset ys k y)))
+                    (.set out s #js [hs xs ys]))))
+      out)))
+
+(defn- prefix-count
+  "How many of the ascending `heights` give h / hs ≤ bound. A prefix: h ↦ h / hs never decreases (IEEE division is
+   monotone; NaN, from ∞/∞, comes only last and is ≤ nothing)."
+  [^js heights hs bound]
+  (loop [lo 0, hi (.-length heights)]
+    (if (< lo hi)
+      (let [mid (unsigned-bit-shift-right (+ lo hi) 1)]
+        (if (<= (/ (aget heights mid) hs) bound) (recur (inc mid) hi) (recur lo mid)))
+      lo)))
+
 (defn note-page-signature?
   "SIG (ADR-0048 §2.2): does page `note` (its runs) annotate slide page `slide` (its runs)? `diag` is the note page's
    diagonal in page units. true when the note page holds a SCALED COPY of the slide: upright runs that repeat the
@@ -252,7 +320,11 @@
    origin, covering at least half of the slide's characters; false otherwise. When the slide has no upright text, the
    default template's date decides: true when the note page has a rotated date, false when it has none, and nil (no
    evidence) when it has no text at all. nil also when a page exceeds max-signature-runs or the pairs exceed
-   max-signature-matches."
+   max-signature-matches.
+   The MATCHES of a slide run are the note page's upright runs of its string with σ = h / hs in
+   (0, max-thumbnail-scale]. Sorted by height, they are one index range (two binary searches, prefix-count), so the
+   pairs that cannot match are never visited; they are counted before one is built, and built into arrays of exactly
+   that size (docs/theory/12 §3.7, docs/scientific/14)."
   [slide note diag]
   (when (and (<= (count slide) max-signature-runs) (<= (count note) max-signature-runs))
     (let [s-runs   (into [] (filter #(and (upright? %) (pos? (glyphs %)))) slide)
@@ -260,28 +332,52 @@

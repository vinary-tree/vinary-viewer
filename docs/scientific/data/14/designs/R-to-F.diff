-            (copy-covers? glyph-of matches tol (/ total 2))))))))
+        (let [groups (by-height note)
+              tol    (max 1e-9 (* offset-tolerance diag))
+              n      (count s-runs)
+              kept   (js/Int32Array. (* 2 n))   ; slide run i keeps its string's runs [kept[2i], kept[2i+1])
+              m      (loop [i 0, m 0]
+                       (cond
+                         (> m max-signature-matches) nil
+                         (= i n)                     m
+                         :else
+                         (let [r (nth s-runs i)]
+                           (if-let [^js g (.get groups (:str r))]
+                             (let [hs (run-height r)
+                                   lo (prefix-count (aget g 0) hs 0)
+                                   hi (prefix-count (aget g 0) hs max-thumbnail-scale)]
+                               (aset kept (* 2 i) lo)
+                               (aset kept (inc (* 2 i)) hi)
+                               (recur (inc i) (+ m (- hi lo))))
+                             (recur (inc i) m)))))]
+          (when m

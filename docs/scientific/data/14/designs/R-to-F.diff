+(def ^:private pack-limit
+  ;; a cell index within ±pack-limit packs, with the other two, into one exact double (cell-key)
+  65535)
+
+(defn- cell-key
+  "The js/Map key of the cell (a, b, c) of one grid. One double when every index lies within ±pack-limit:
+   (a + 2^16)·2^34 + (b + 2^16)·2^17 + (c + 2^16) — three base-2^17 digits, below 2^51, so exact and different for
+   every triple; −0 packs as 0, as `str` prints both \"0\". Otherwise the string \"a,b,c\" (an index that is huge, ±∞ or
+   NaN, from extreme coordinates). A number is never the same js/Map key as a string, so distinct cells never share a
+   key."
+  [a b c]
+  (if (and (<= (- pack-limit) a pack-limit) (<= (- pack-limit) b pack-limit) (<= (- pack-limit) c pack-limit))
+    (+ (* (+ a 65536) 17179869184) (* (+ b 65536) 131072) (+ c 65536))
+    (str a "," b "," c)))
+

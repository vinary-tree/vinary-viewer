;; vinary-viewer vim keymap (modal: normal/insert/visual; leader = SPC; ":" ex; "/" search).
;; Nested map = key sequence; "SPC" normalizes to the space token at load.
{:name :vim
 :initial-mode :normal
 :timeout-ms 1000
 :leader "SPC"
 :modes
 {:normal
  {"j"   :nav/scroll-down
   "k"   :nav/scroll-up
   "h"   :nav/scroll-left
   "l"   :nav/scroll-right
   "f"   :hint/start
   "C-d" :nav/half-page-down
   "C-u" :nav/half-page-up
   "C-f" :nav/page-down
   "C-b" :nav/page-up
   "g"   {"g" :nav/scroll-top "t" :tab/next "T" :tab/prev}
   "G"   :nav/scroll-bottom
   ;; vim fold idiom over a diff's per-file previews (ADR-0037; self-gate: no-op outside a diff).
   ;; No "z a" — there is no cursor-over-file concept; `f` link-hints are the per-file toggle.
   "z"   {"M" :view/diff-collapse-all "R" :view/diff-expand-all}
   "C-w" {"h" :focus/sidebar "l" :focus/content "w" :focus/toggle "q" :tab/close}
   "C-o" :file/open-dialog
   "C-i" :history/forward
   "H"   :history/back
   "L"   :history/forward
   "K"   :nav/parent          ; like Alt+Up — up to the parent directory
   "J"   :nav/open-target     ; like Alt+Down — open the highlighted file/folder
   "/"   :search/start
   "n"   :search/next
   "N"   :search/prev
   ":"   :mode/ex
   "C-n" :tree/down
   "C-p" :tree/up
   "i"   :mode/insert
   "v"   :mode/visual
   "escape" :input/escape
   "SPC" {"f" {"f" :file/open "t" :file/open-in-new-tab "r" :file/reveal-in-tree}
          "b" {"d" :tab/close "n" :tab/next "p" :tab/prev "b" :palette/files}
          "w" {"d" :tab/close}
          "t" {"t" :theme/cycle "s" :sidebar/toggle}
          "s" {"s" :search/start}
          "SPC" :palette/open}}
  :visual
  {"escape" :mode/normal
   "j" :nav/scroll-down
   "k" :nav/scroll-up
   ":" :mode/ex}
  :insert
  {"escape" :input/escape}
  :all
  {"escape" :input/escape
   ;; slide show (ADR-0045): F5 presents the shown PDF from the first slide, Shift+F5 from the current one
   "f5"   :slides/present
   "S-f5" :slides/present-current
   ;; Alt+arrow navigation is keymap-independent (here in :all, not :normal, so vim's normal
   ;; mode does not consume them): ←/→ history, ↑ parent dir, ↓ open highlighted target.
   "M-left"  :history/back
   "M-right" :history/forward
   "M-up"    :nav/parent
   "M-down"  :nav/open-target
   "C-o" :file/open-dialog
   "C-S-o" :file/open-dialog-new-tab
   "C-l" :focus/uri
   "C-t" :tab/new-blank
   ;; Ctrl+PageUp / Ctrl+PageDown cycle tabs left / right, in every mode (Vim also has g t / g T in :normal)
   "C-prior" :tab/prev
   "C-next"  :tab/next
   ;; font-size / zoom (whole-app, like a browser) — bind both C-= and C-+ so it works with/without Shift
   "C-0" :view/zoom-reset
   "C-=" :view/zoom-in
   "C-+" :view/zoom-in
   "C--" :view/zoom-out}
  ;; ADR-0045 — the SLIDES layer. Active only while a PDF is shown in the slides layout AND the keyboard is on the
  ;; document (not a text field, the sidebar, the URI bar, or an open overlay). It sits BELOW the mode, so a
  ;; mode's own binding of the same key wins (Vim's Space leader). Arrows, PageUp/PageDown (Shift = a whole
  ;; frame), Home/End and every keymap's scroll keys already flip slides through the scroll delegate — they are
  ;; not bound here. Identical in every preset (a test asserts it); override it in keybindings.edn under
  ;; :keymaps {:slides {…}}.
  :slides
  {"space"     :slides/next
   "S-space"   :slides/prev
   "backspace" :slides/backspace           ; deletes a typed digit, else the previous slide
   "enter"     :slides/enter               ; goes to the typed slide, else the next one
   "S-right"   :slides/next-frame          ; a frame = all the overlay pages of one Beamer slide
   "S-down"    :slides/next-frame
   "S-left"    :slides/prev-frame
   "S-up"      :slides/prev-frame
   "b"         :slides/black               ; while presenting: blank to black (again = back), like pdfpc
   "."         :slides/black
   "w"         :slides/white               ; while presenting: blank to white
   ","         :slides/white
   "0" {:id :slides/digit :args [0]} "1" {:id :slides/digit :args [1]} "2" {:id :slides/digit :args [2]}
   "3" {:id :slides/digit :args [3]} "4" {:id :slides/digit :args [4]} "5" {:id :slides/digit :args [5]}
   "6" {:id :slides/digit :args [6]} "7" {:id :slides/digit :args [7]} "8" {:id :slides/digit :args [8]}
   "9" {:id :slides/digit :args [9]}}}}

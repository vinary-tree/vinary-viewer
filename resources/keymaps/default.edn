;; vinary-viewer default keymap (non-modal). Generalizes the original Ctrl+F / Alt+←→ behavior.
;; Keys are canonical chord tokens (see vinary.input.keys); a nested map = a key sequence (prefix);
;; a keyword or {:id … :when …} = a command in vinary.app.commands/registry.
{:name :default
 :initial-mode :insert            ; non-modal: bare keys reach inputs normally
 :timeout-ms 1000
 :leader nil
 :modes
 {:all
  {"C-f"     :search/start
   "M-left"  :history/back
   "M-right" :history/forward
   "M-up"    :nav/parent
   "M-down"  :nav/open-target
   "C-tab"   :tab/next
   "C-S-tab" :tab/prev
   ;; Ctrl+PageUp / Ctrl+PageDown cycle tabs left / right (browser-style; Vim also has g t / g T)
   "C-prior" :tab/prev
   "C-next"  :tab/next
   "C-w"     :tab/close
   "C-o"     :file/open-dialog
   "C-S-o"   :file/open-dialog-new-tab
   "C-r"     :doc/reload
   "C-l"     :focus/uri
   "C-p"     :palette/files
   "C-S-p"   :palette/open
   "C-b"     :sidebar/toggle
   "C-S-s"   :view/toggle-source           ; Preview ↔ Source of the shown file (self-gates: no-op when no other facet)
   "C-S-b"   :view/toggle-diff-split        ; Unified ↔ Split diff (self-gates: no-op for non-diff docs)
   "C-S-g"   :git/blame-toggle              ; per-line blame gutter (self-gates: no-op without a local source view)
   "C-t"     :tab/new-blank
   "C-0"     :view/zoom-reset
   "C-="     :view/zoom-in
   "C-+"     :view/zoom-in
   "C--"     :view/zoom-out
   "C-S-i"   :view/devtools
   "C-g"     :input/escape
   ;; slide show (ADR-0045): F5 presents the shown PDF from the first slide, Shift+F5 from the current one
   "f5"      :slides/present
   "S-f5"    :slides/present-current
   "S"       :slides/present-linked     ; Present in New Window: the notes stay in this window (ADR-0048 §8)
   "f3"      :search/next
   "S-f3"    :search/prev
   "escape"  :input/escape}
  ;; ADR-0045 — the SLIDES layer. Active only while a PDF is shown in the slides layout AND the keyboard is on the
  ;; document (not a text field, the sidebar, the URI bar, or an open overlay). It sits BELOW the mode, so a
  ;; mode's own binding of the same key wins (Vim's Space leader). Arrows, PageUp/PageDown (Shift = a whole
  ;; frame), Home/End and every keymap's scroll keys already flip slides through the scroll delegate — they are
  ;; not bound here. Identical in every preset (a test asserts it); override it in keybindings.edn under
  ;; :keymaps {:slides {…}}.
  :slides
  {"space"     :slides/next
   "S-space"   :slides/prev
   "n"         :slides/next
   "p"         :slides/prev
   "backspace" :slides/backspace           ; deletes a typed digit, else the previous slide
   "enter"     :slides/enter               ; goes to the typed slide, else the next one
   "S-right"   :slides/next-frame          ; a frame = all the overlay pages of one Beamer slide
   "S-down"    :slides/next-frame
   "S-left"    :slides/prev-frame
   "S-up"      :slides/prev-frame
   "b"         :slides/black               ; while presenting: blank to black (again = back), like pdfpc
   "."         :slides/black
   "w"         :slides/white               ; while presenting: blank to white
   ","         :slides/white
   "tab"       :slides/overview            ; the overview grid of frames (pdfpc's Tab); Tab / o / Escape close it
   "o"         :slides/overview
   "s"         :slides/presenter-view      ; the presenter view: the slide beside its notes and the next slide (ADR-0048)
   "F"         :slides/fullscreen          ; during a show: this window's fullscreen on / off (ADR-0048 §7)
   "0" {:id :slides/digit :args [0]} "1" {:id :slides/digit :args [1]} "2" {:id :slides/digit :args [2]}
   "3" {:id :slides/digit :args [3]} "4" {:id :slides/digit :args [4]} "5" {:id :slides/digit :args [5]}
   "6" {:id :slides/digit :args [6]} "7" {:id :slides/digit :args [7]} "8" {:id :slides/digit :args [8]}
   "9" {:id :slides/digit :args [9]}}}}
